DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai_agent_platform
APP_NAME=AI Agent Platform
ENVIRONMENT=development

# Fernet key para cifrar secretos persistidos (ej. virtual keys de LiteLLM
# por tenant). Generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-generated-fernet-key
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=replace-with-your-litellm-master-key

# Virtual key de LiteLLM acotada (budget bajo, un solo modelo barato) que
# get_tenant_llm_client() usa cuando una organizacion todavia no tiene su
# propia virtual key aprovisionada. La master key de arriba NUNCA debe
# autenticar trafico real de chat -- solo /key/generate y llamadas admin
# equivalentes. Generarla, con el proxy LiteLLM ya corriendo, con:
# python -m scripts.create_emergency_fallback_key
# Requerida: la app falla al arrancar si falta (ver app/core/config.py).
LITELLM_EMERGENCY_FALLBACK_KEY=replace-with-the-generated-emergency-fallback-key
EMERGENCY_FALLBACK_DAILY_BUDGET_USD=2.0

# Opcional: solo la usa eval_harness/model_routing_eval.py, nunca el
# trafico real de la app -- por eso NO es requerida al arrancar, a
# diferencia de la de emergencia. A diferencia de esa tambien, tiene
# acceso al modelo caro (claude-sonnet-5) ademas del barato, porque el
# eval necesita poder medir routing hacia ambos tiers. Generarla con:
# python -m scripts.create_eval_virtual_key
LITELLM_EVAL_VIRTUAL_KEY=replace-with-the-generated-eval-virtual-key
EVAL_VIRTUAL_KEY_DAILY_BUDGET_USD=5.0

DEFAULT_TENANT_MONTHLY_BUDGET=10.0

# OAuth de Google para leer/responder correos de tracking por Gmail
# (app.gmail). Opcionales: sin ellas solo falla /gmail/connect (503).
# GOOGLE_REDIRECT_URI debe coincidir EXACTAMENTE con una URI de
# redireccionamiento autorizada del cliente OAuth. Scopes que se piden:
# gmail.readonly + gmail.send (minimo necesario, sin gmail.modify).
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback
GMAIL_POLL_LOOKBACK=2d
GMAIL_POLL_INTERVAL_SECONDS=60
GMAIL_MAX_MESSAGES_PER_POLL=20
GMAIL_MAX_REPLIES_PER_SENDER_PER_DAY=3
GMAIL_MAX_GUIDE_REQUESTS_PER_SENDER_PER_DAY=1
# Solo compartir el estado de un envio con quien escribe desde el correo
# del cliente de ese envio (y con SPF/DKIM/DMARC aprobado por Gmail).
GMAIL_REQUIRE_SENDER_MATCH=true
# Formato de una guia suelta (sin la palabra "guia"/"tracking" delante).
# Ej. para guias tipo IR-2024-00123: [A-Za-z]{2}-\d{4}-\d{5}
GMAIL_TRACKING_BARE_PATTERN=\d{6,15}
